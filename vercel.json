{
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/redefinir-senha", "destination": "/index.html" },
    { "source": "/resumo", "destination": "/index.html" },
    { "source": "/lancamentos", "destination": "/index.html" },
    { "source": "/patrimonio/:path*", "destination": "/index.html" },
    { "source": "/planejamento", "destination": "/index.html" },
    { "source": "/perfil", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
